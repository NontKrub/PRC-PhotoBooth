    },
    "Waiting for operator": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอผู้ควบคุม"
          }
        }
      }
    },
    "Waiting for operator…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอผู้ควบคุม…"
          }
        }
      }
    },
    "Warm": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทนอุ่น"
          }
        }
      }
    },
    "Wireless": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไร้สาย"
          }
        }
      }
    },
    "You're up!": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงตาคุณแล้ว!"
