    "%@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@"
          }
        }
      }
    },
    "%@ is open — it may block the camera session.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เปิดอยู่ — อาจรบกวนการใช้กล้อง"
          }
        }
      }
    },
    "%@ of %@ photos accepted · next photo %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จาก %2$@ รูปที่ยอมรับ · รูปถัดไป %3$@"
